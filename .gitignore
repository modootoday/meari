# Public source allowlist. Internal specs/history and generated output stay local.
*
!/.gitignore
!/.gitattributes
!/Cargo.toml
!/Cargo.lock
!/README.md
!/LICENSE-MIT
!/LICENSE-APACHE
!/NOTICE
!/docs/
!/docs/**/*.md
!/packages/
!/packages/*/
!/packages/*/Cargo.toml
!/packages/*/README.md
!/packages/*/src/
!/packages/*/src/**/
!/packages/*/src/**/*.rs
!/packages/*/tests/
!/packages/*/tests/**/
!/packages/*/tests/**/*.rs
!/packages/*/fixtures/
!/packages/*/fixtures/**
!/packages/*/assets/
!/packages/*/assets/**/
!/packages/*/assets/**/*.svg

# Even source directories may contain local editor/build artifacts.
**/target/
**/node_modules/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/credentials.json
**/*.log
**/*.pdb
**/*.ilk
**/*.obj
**/*.exp
**/*.exe
**/*.dll
**/*.wasm
**/*.tmp
**/*.bak
